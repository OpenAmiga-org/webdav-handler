; Install script for nextcloud-handler (AmigaOS 4 Installation Utility).
; Public domain.

(set #app "Nextcloud Handler")
(set @app-name "NextcloudHandler")
(set @default-dest "L:")

(set #bad 0)
(set #missing "")

(welcome
  (cat "This installs " #app ": the device NCH: shows your Nextcloud and "
       "WebDAV servers as folders, and the prefs program nchprefs keeps the "
       "list of servers."))

(if (= @user-level 0) (user 1))

; --- requirements -------------------------------------------------------

(procedure P_CHECK #lib #minver #minrev #what #where
  (set #v (getversion #lib (resident)))
  (if (= #v 0) (set #v (getversion (tackon "LIBS:" #lib))))
  (if (< #v (+ (* #minver 65536) #minrev))
    (
      (set #bad 1)
      (set #missing (cat #missing "\n\n" #what " (" #lib " " #minver "." #minrev
                         " or newer) is missing or too old.\nGet it from: " #where))
    )
  )
)

(P_CHECK "filesysbox.library" 54 8 "filesysbox"
         "AmigaOS 4.1 Final Edition updates")
(P_CHECK "clib4.library" 2 5 "clib4"
         "OS4Depot development/library/misc/clib4.lha\nor https://github.com/AmigaLabs/clib4/releases")
(P_CHECK "amisslmaster.library" 5 0 "AmiSSL"
         "OS4Depot library/misc/amissl.lha\nor https://github.com/jens-maus/amissl/releases")

(if #bad
  (if (= 0 (askbool
        (prompt (cat "Some required libraries are missing:" #missing
                     "\n\nThe handler cannot work without them. You can install "
                     "it now and add the libraries later."))
        (help @askbool-help)
        (choices "Install anyway" "Stop")
        (default 0)))
    (exit (quiet))
  )
)

; --- programs -------------------------------------------------------------

; leftovers of an earlier install (see P_FREE), now no longer in use
(run "C:Delete >NIL: QUIET L:nextcloud-handler.old SYS:Prefs/nchprefs.old")

; A running handler keeps L:nextcloud-handler in use: it cannot be
; replaced while NCH: is mounted. Stop it first; it is mounted again at
; the end.
(set #wasmounted (= 0 (run "C:Assign >NIL: NCH: EXISTS")))
(if #wasmounted
  (
    (message "NCH: is mounted. To replace the handler, the installer "
             "stops it now and mounts it again at the end.\n\n"
             "Close any files you have open on NCH: first.")
    (run "C:Dismount >NIL: NCH:")
  )
)

; A file that is still in use (NCH: could not be stopped, or nchprefs is
; running) is moved aside, so that the new one can be copied in; the old
; one goes with the next restart.
(procedure P_FREE #file
  (if (exists #file)
    (if (<> 0 (run (cat "C:Delete >NIL: QUIET \"" #file "\"")))
      (
        (run (cat "C:Delete >NIL: QUIET \"" #file ".old\""))
        (run (cat "C:Rename >NIL: \"" #file "\" \"" #file ".old\""))
      )
    )
  )
)
(P_FREE "L:nextcloud-handler")
(copyfiles
  (prompt "Copying nextcloud-handler to L:")
  (help @copyfiles-help)
  (source "L/nextcloud-handler")
  (dest "L:")
  (confirm "expert"))

(P_FREE "SYS:Prefs/nchprefs")
(copyfiles
  (prompt "Copying the prefs program nchprefs to SYS:Prefs")
  (help @copyfiles-help)
  (source "Prefs/nchprefs")
  (dest "SYS:Prefs")
  (infos)
  (confirm "expert"))

; --- the DOSDriver ------------------------------------------------------

(set #activate
  (askbool
    (prompt "Mount NCH: every time the computer starts?\n"
            "(It connects to a server only when its folder is opened.)")
    (help @askbool-help)
    (default 1)))

(set #dddest (if #activate "DEVS:DOSDrivers" "SYS:Storage/DOSDrivers"))
(if (exists (tackon #dddest "NCH"))
  (if (= 0 (askbool
        (prompt (cat (tackon #dddest "NCH") " exists already. Replace it?"))
        (help @askbool-help)
        (default 1)))
    (set #dddest "")
  )
)
(if (<> #dddest "")
  (copyfiles
    (prompt (cat "Copying the DOSDriver to " #dddest))
    (help @copyfiles-help)
    (source "Devs/DOSDrivers/NCH")
    (dest #dddest)
    (infos)
    (nogauge))
)

; --- documentation ------------------------------------------------------

(set #docdir
  (askdir
    (prompt "Where should the documentation go?\n"
            "A drawer named NextcloudHandler is created there.")
    (help @askdir-help)
    (default "SYS:Documentation")))

(set #docs (tackon #docdir "NextcloudHandler"))
(makedir #docs (prompt "Creating the documentation drawer") (help @makedir-help) (infos))
(foreach "" "#?.(guide|txt)"
  (copyfiles
    (prompt "Copying the documentation")
    (help @copyfiles-help)
    (source @each-name)
    (dest #docs)
    (infos)
    (nogauge)))

; --- mount now ----------------------------------------------------------

; the DOSDriver to mount: the one just copied, or the one that was there
(set #ddfile "")
(if (<> #dddest "")
  (set #ddfile (tackon #dddest "NCH"))
  (if (exists "DEVS:DOSDrivers/NCH")
    (set #ddfile "DEVS:DOSDrivers/NCH")
    (if (exists "SYS:Storage/DOSDrivers/NCH")
      (set #ddfile "SYS:Storage/DOSDrivers/NCH"))))

(if (= 0 (run "C:Assign >NIL: NCH: EXISTS"))
  ; still mounted: Dismount did not work (files open on NCH:)
  (message "NCH: could not be stopped, so the old handler keeps running. "
           "The new one is used after the computer restarts.")
  (if (and (<> #ddfile "") (or #wasmounted (<> #dddest "")))
    (run (cat "C:Mount " #ddfile)))
)

; nchprefs also takes the servers over from the DOSDrivers of version
; 0.37 and older (one device per server), and offers to delete them
(if (askbool
      (prompt "Start nchprefs now to set up your servers?\n\n"
              "If you used an older version with a DOSDriver for each "
              "server (NC0: and so on), nchprefs takes those servers over.")
      (help @askbool-help)
      (default 1))
  (run "Run >NIL: SYS:Prefs/nchprefs")
)

(exit (cat #app " is installed.\n\nAdd your servers with SYS:Prefs/nchprefs; "
           "they appear as folders in NCH:.\nRead " (tackon #docs "NextcloudHandler.guide")
           " for the details.") (quiet))
